{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile and library selection",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "currentGroupId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "leader", "member", "editor", "viewer"] },
        "accesses": { "type": "array" },
        "personalCapos": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "currentGroupId", "role"]
    },
    "Group": {
      "title": "Group",
      "description": "Isolated music library with its own subcollection database",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "members": { "type": "array" },
        "memberRoles": { "type": "object" },
        "memberAccesses": { "type": "object" },
        "inviteCode": { "type": "string", "maxLength": 32 },
        "guestEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "members", "inviteCode"]
    },
    "LibraryInvite": {
      "title": "LibraryInvite",
      "description": "Direct lookup index mapping a single library code to its library ID for member joining and read-only visitor access",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "maxLength": 32 },
        "groupId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "groupId", "name", "ownerId"]
    },
    "LibraryMember": {
      "title": "LibraryMember",
      "description": "Member entry scoped to a single library",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "leader", "member", "editor", "viewer"] },
        "accesses": { "type": "array" },
        "instruments": { "type": "array" },
        "vocalRoles": { "type": "array" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role"]
    },
    "Song": {
      "title": "Song",
      "description": "Song sheet with ChordPro content inside a library database",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "artist": { "type": "string", "maxLength": 200 },
        "album": { "type": "string", "maxLength": 200 },
        "key": { "type": "string", "maxLength": 24 },
        "tempo": { "type": "number" },
        "bpm": { "type": "number" },
        "timeSignature": { "type": "string", "maxLength": 20 },
        "duration": { "type": "string", "maxLength": 32 },
        "durationMode": { "type": "string", "enum": ["auto", "custom"] },
        "ccli": { "type": "string", "maxLength": 64 },
        "copyright": { "type": "string", "maxLength": 500 },
        "youtubeUrl": { "type": "string", "maxLength": 1000 },
        "audioUrl": { "type": "string", "maxLength": 1000 },
        "spotifyUrl": { "type": "string", "maxLength": 1000 },
        "contentChordPro": { "type": "string", "maxLength": 100000 },
        "content": { "type": "string", "maxLength": 100000 },
        "folderId": { "type": "string", "maxLength": 128 },
        "capo": { "type": "number" },
        "tags": { "type": "array" },
        "language": { "type": "string", "maxLength": 40 },
        "linkedSongIds": { "type": "array" },
        "notes": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "title", "contentChordPro"]
    },
    "Setlist": {
      "title": "Setlist",
      "description": "Curated list of songs inside a library database",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 64 },
        "songIds": { "type": "array" },
        "songOverrides": { "type": "object" },
        "notes": { "type": "string", "maxLength": 5000 },
        "targetDuration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "name", "songIds"]
    },
    "SetlistHistory": {
      "title": "SetlistHistory",
      "description": "Performance history inside a library database",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "setlistId": { "type": "string", "maxLength": 128 },
        "setlistName": { "type": "string", "maxLength": 200 },
        "eventType": { "type": "string", "enum": ["rehearsal", "concert", "service", "other"] },
        "date": { "type": "string", "maxLength": 64 },
        "durationMinutes": { "type": "number" },
        "location": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 5000 },
        "songIds": { "type": "array" },
        "songsSnapshot": { "type": "array" },
        "playedByUid": { "type": "string", "maxLength": 128 },
        "playedByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "setlistName", "eventType", "date"]
    },
    "CustomPad": {
      "title": "CustomPad",
      "description": "Library-scoped audio pads with pitch shift metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "rootSemitone": { "type": "number" },
        "rootKey": { "type": "string", "maxLength": 16 },
        "audioUrl": { "type": "string", "maxLength": 750000 },
        "fileSize": { "type": "number" },
        "duration": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "name", "rootSemitone", "rootKey"]
    },
    "RoadmapItem": {
      "title": "RoadmapItem",
      "description": "Global application feature idea or bug report card",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "category": { "type": "string", "enum": ["idea", "bug"] },
        "status": { "type": "string", "enum": ["idea_bug", "in_progress", "live"] },
        "images": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "lastCommentId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "description",
        "category",
        "status",
        "images",
        "authorId",
        "authorName",
        "likesCount",
        "commentsCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoadmapLike": {
      "title": "RoadmapLike",
      "description": "Single user upvote for a roadmap item",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "RoadmapComment": {
      "title": "RoadmapComment",
      "description": "Comment on a roadmap item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "itemId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "itemId", "text", "authorId", "authorName", "createdAt"]
    },
    "PlanningTeam": {
      "title": "PlanningTeam",
      "description": "Reusable team/group preset of musicians, singers, and regie technicians inside a library",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "color": { "type": "string", "maxLength": 32 },
        "members": { "type": "array" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "name", "members"]
    },
    "MemberGroup": {
      "title": "MemberGroup",
      "description": "Organizational member subgroup inside a library (cumulative membership per member)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 300 },
        "color": { "type": "string", "enum": ["blue", "emerald", "purple", "amber", "rose", "slate"] },
        "memberIds": { "type": "array" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "name", "memberIds"]
    },
    "PlanningAvailability": {
      "title": "PlanningAvailability",
      "description": "Per-member availability status for a specific date inside a library",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["available", "maybe", "unavailable"] },
        "preferredPoles": { "type": "array" },
        "note": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "date", "uid", "displayName", "status"]
    },
    "PlanningAssignment": {
      "title": "PlanningAssignment",
      "description": "Scheduled roster of musicians, singers, and regie technicians for a setlist or date",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupId": { "type": "string", "maxLength": 128 },
        "setlistId": { "type": "string", "maxLength": 128 },
        "setlistName": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "callTime": { "type": "string", "maxLength": 20 },
        "serviceTime": { "type": "string", "maxLength": 20 },
        "location": { "type": "string", "maxLength": 200 },
        "rehearsalDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "rehearsalTime": { "type": "string", "maxLength": 20 },
        "rehearsalLocation": { "type": "string", "maxLength": 200 },
        "teamPresetId": { "type": "string", "maxLength": 128 },
        "teamPresetName": { "type": "string", "maxLength": 120 },
        "slots": { "type": "array" },
        "notes": { "type": "string", "maxLength": 5000 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupId", "date", "title", "slots"]
    },
    "AppBrandingConfig": {
      "title": "AppBrandingConfig",
      "description": "Global application branding configuration (logo, colors, typography) managed exclusively by the Supreme Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "logoMode": { "type": "string", "enum": ["default", "custom"] },
        "customLogoDataUrl": { "type": "string", "maxLength": 260000 },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "lightBgColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "lightSurfaceColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "darkBgColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "darkSurfaceColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "fontFamily": {
          "type": "string",
          "enum": [
            "plus-jakarta-sans",
            "outfit",
            "manrope",
            "dm-sans",
            "bricolage-grotesque",
            "public-sans",
            "playfair-display",
            "lora"
          ]
        },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "logoMode",
        "accentColor",
        "lightBgColor",
        "lightSurfaceColor",
        "darkBgColor",
        "darkSurfaceColor",
        "fontFamily",
        "updatedBy",
        "updatedAt"
      ]
    },
    "MemberSkillsConfig": {
      "title": "MemberSkillsConfig",
      "description": "Global default instruments and vocal roles selectable across the app, managed exclusively by the Supreme Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "instruments": { "type": "array" },
        "vocalRoles": { "type": "array" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "instruments",
        "vocalRoles",
        "updatedBy",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": "AppBrandingConfig",
      "description": "Global application configuration (branding and default member skills)"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles"
    },
    "/library_invites/{inviteCode}": {
      "schema": "LibraryInvite",
      "description": "Single library code lookup for joining as member or read-only visitor access"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Music libraries"
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": "LibraryMember",
      "description": "Members belonging to a specific library"
    },
    "/groups/{groupId}/songs/{songId}": {
      "schema": "Song",
      "description": "Songs isolated per library"
    },
    "/groups/{groupId}/setlists/{setlistId}": {
      "schema": "Setlist",
      "description": "Setlists isolated per library"
    },
    "/groups/{groupId}/setlist_history/{historyId}": {
      "schema": "SetlistHistory",
      "description": "Performance history isolated per library"
    },
    "/groups/{groupId}/custom_pads/{padId}": {
      "schema": "CustomPad",
      "description": "Audio pads isolated per library"
    },
    "/groups/{groupId}/planning_teams/{teamId}": {
      "schema": "PlanningTeam",
      "description": "Reusable planning team presets isolated per library"
    },
    "/groups/{groupId}/planning_availabilities/{availId}": {
      "schema": "PlanningAvailability",
      "description": "Member date availabilities isolated per library"
    },
    "/groups/{groupId}/planning_assignments/{assignmentId}": {
      "schema": "PlanningAssignment",
      "description": "Setlist and date planning rosters isolated per library"
    },
    "/groups/{groupId}/member_groups/{memberGroupId}": {
      "schema": "MemberGroup",
      "description": "Organizational member subgroups isolated per library"
    },
    "/roadmap_items/{itemId}": {
      "schema": "RoadmapItem",
      "description": "Global roadmap feature ideas and bug reports"
    },
    "/roadmap_items/{itemId}/likes/{userId}": {
      "schema": "RoadmapLike",
      "description": "Per-user likes on a roadmap item"
    },
    "/roadmap_items/{itemId}/comments/{commentId}": {
      "schema": "RoadmapComment",
      "description": "Comments on a roadmap item"
    }
  }
}
