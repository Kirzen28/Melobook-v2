rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'kriveravelasquez@rivera-marketing.com'
        && request.auth.token.email_verified == true;
    }

    // Master Gate helpers for per-library isolation
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function isLibraryMember(groupId) {
      return isSignedIn()
        && exists(groupPath(groupId))
        && (
          isBootstrappedAdmin() ||
          groupData(groupId).ownerId == request.auth.uid ||
          (groupData(groupId).members is list && request.auth.uid in groupData(groupId).members)
        );
    }

    function isValidAccessList(listVal) {
      return listVal is list
        && listVal.size() <= 5
        && listVal.hasOnly(['admin', 'setlists', 'chants', 'pupitre', 'regie']);
    }

    function libraryRole(groupId) {
      let g = groupData(groupId);
      return g.ownerId == request.auth.uid
        ? 'admin'
        : (g.memberRoles is map ? g.memberRoles.get(request.auth.uid, 'member') : 'member');
    }

    function hasLibraryAccess(groupId, accessKey) {
      let g = groupData(groupId);
      return isBootstrappedAdmin()
        || g.ownerId == request.auth.uid
        || (
          g.memberAccesses is map
          && request.auth.uid in g.memberAccesses
          && g.memberAccesses[request.auth.uid] is list
          && ('admin' in g.memberAccesses[request.auth.uid] || accessKey in g.memberAccesses[request.auth.uid])
        )
        || (
          (!(g.memberAccesses is map) || !(request.auth.uid in g.memberAccesses))
          && (
            (accessKey == 'admin' && libraryRole(groupId) == 'admin') ||
            (accessKey == 'chants' && libraryRole(groupId) in ['admin', 'leader', 'editor']) ||
            (accessKey == 'setlists' && libraryRole(groupId) in ['admin', 'leader']) ||
            (accessKey == 'pupitre' && libraryRole(groupId) in ['admin', 'leader', 'editor', 'member']) ||
            (accessKey == 'regie' && libraryRole(groupId) in ['admin', 'leader', 'editor', 'member', 'viewer'])
          )
        );
    }

    function isLibraryAdmin(groupId) {
      return isLibraryMember(groupId) && hasLibraryAccess(groupId, 'admin');
    }

    function canEditLibrarySongs(groupId) {
      return isLibraryMember(groupId) && hasLibraryAccess(groupId, 'chants');
    }

    function canEditLibrarySetlists(groupId) {
      return isLibraryMember(groupId) && hasLibraryAccess(groupId, 'setlists');
    }

    function isGuestReadableLibrary(groupId) {
      return exists(groupPath(groupId)) && groupData(groupId).guestEnabled == true;
    }

    // Validation Blueprints
    function isValidHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidAppBrandingConfig(data) {
      return data.keys().hasAll([
          'id', 'logoMode', 'accentColor', 'lightBgColor', 'lightSurfaceColor',
          'darkBgColor', 'darkSurfaceColor', 'fontFamily', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'logoMode', 'customLogoDataUrl', 'accentColor', 'lightBgColor',
          'lightSurfaceColor', 'darkBgColor', 'darkSurfaceColor', 'fontFamily',
          'updatedBy', 'updatedAt'
        ])
        && data.id == 'branding'
        && data.logoMode in ['default', 'custom']
        && (!('customLogoDataUrl' in data) || data.customLogoDataUrl == null || (data.customLogoDataUrl is string && data.customLogoDataUrl.size() <= 260000))
        && isValidHexColor(data.accentColor)
        && isValidHexColor(data.lightBgColor)
        && isValidHexColor(data.lightSurfaceColor)
        && isValidHexColor(data.darkBgColor)
        && isValidHexColor(data.darkSurfaceColor)
        && data.fontFamily in [
          'plus-jakarta-sans', 'outfit', 'manrope', 'dm-sans',
          'bricolage-grotesque', 'public-sans', 'playfair-display', 'lora'
        ]
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidSkillStringList(listVal, maxLen) {
      return listVal is list
        && listVal.size() <= maxLen
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() >= 1 && listVal[0].size() <= 80));
    }

    function isValidMemberSkillsConfig(data) {
      return data.keys().hasAll(['id', 'instruments', 'vocalRoles', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'instruments', 'vocalRoles', 'updatedBy', 'updatedAt'])
        && data.id == 'member_skills'
        && isValidSkillStringList(data.instruments, 50)
        && isValidSkillStringList(data.vocalRoles, 30)
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'currentGroupId', 'role'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'currentGroupId', 'role', 'accesses', 'personalCapos', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (data.currentGroupId == null || (data.currentGroupId is string && data.currentGroupId.size() <= 128))
        && data.role in ['admin', 'leader', 'member', 'editor', 'viewer']
        && (!('accesses' in data) || isValidAccessList(data.accesses))
        && (!('personalCapos' in data) || (data.personalCapos is map && data.personalCapos.size() <= 1000));
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'members', 'inviteCode'])
        && data.keys().hasOnly(['id', 'name', 'description', 'ownerId', 'members', 'memberRoles', 'memberAccesses', 'inviteCode', 'guestEnabled', 'guestCode', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.members is list && data.members.size() >= 1 && data.members.size() <= 500
        && data.members[0] is string
        && (!('memberRoles' in data) || data.memberRoles is map)
        && (!('memberAccesses' in data) || data.memberAccesses is map)
        && data.inviteCode is string && data.inviteCode.size() >= 3 && data.inviteCode.size() <= 32
        && (!('guestEnabled' in data) || data.guestEnabled is bool)
        && (!('guestCode' in data) || data.guestCode == null || (data.guestCode is string && data.guestCode.size() <= 32));
    }

    function isValidLibraryInvite(data) {
      return data.keys().hasAll(['inviteCode', 'groupId', 'name', 'ownerId'])
        && data.keys().hasOnly(['inviteCode', 'groupId', 'name', 'ownerId', 'createdAt'])
        && data.inviteCode is string && data.inviteCode.size() >= 3 && data.inviteCode.size() <= 32
        && data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128;
    }

    function isValidLibraryMember(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'role', 'accesses',
          'instruments', 'vocalRoles', 'joinedAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['admin', 'leader', 'member', 'editor', 'viewer']
        && (!('accesses' in data) || isValidAccessList(data.accesses))
        && (!('instruments' in data) || (
          data.instruments is list && data.instruments.size() <= 20 &&
          (data.instruments.size() == 0 || (data.instruments[0] is string && data.instruments[0].size() >= 1 && data.instruments[0].size() <= 80))
        ))
        && (!('vocalRoles' in data) || (
          data.vocalRoles is list && data.vocalRoles.size() <= 10 &&
          (data.vocalRoles.size() == 0 || (data.vocalRoles[0] is string && data.vocalRoles[0].size() >= 1 && data.vocalRoles[0].size() <= 80))
        ));
    }

    function isValidSong(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'title', 'contentChordPro'])
        && data.keys().hasOnly([
          'id', 'groupId', 'title', 'artist', 'album', 'key', 'tempo', 'bpm', 'timeSignature',
          'duration', 'durationMode', 'ccli', 'copyright', 'youtubeUrl', 'audioUrl',
          'spotifyUrl', 'contentChordPro', 'content', 'folderId', 'capo', 'tags',
          'language', 'linkedSongIds', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.groupId == groupId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && (!('artist' in data) || data.artist == null || (data.artist is string && data.artist.size() <= 200))
        && (!('album' in data) || data.album == null || (data.album is string && data.album.size() <= 200))
        && (!('key' in data) || data.key == null || (data.key is string && data.key.size() <= 24))
        && (!('tempo' in data) || data.tempo == null || data.tempo is number)
        && (!('bpm' in data) || data.bpm == null || data.bpm is number)
        && (!('timeSignature' in data) || data.timeSignature == null || (data.timeSignature is string && data.timeSignature.size() <= 20))
        && (!('duration' in data) || data.duration == null || (data.duration is string && data.duration.size() <= 32))
        && (!('durationMode' in data) || data.durationMode == null || data.durationMode in ['auto', 'custom'])
        && (!('ccli' in data) || data.ccli == null || (data.ccli is string && data.ccli.size() <= 64))
        && (!('copyright' in data) || data.copyright == null || (data.copyright is string && data.copyright.size() <= 500))
        && (!('youtubeUrl' in data) || data.youtubeUrl == null || (data.youtubeUrl is string && data.youtubeUrl.size() <= 1000))
        && (!('audioUrl' in data) || data.audioUrl == null || (data.audioUrl is string && data.audioUrl.size() <= 1000))
        && (!('spotifyUrl' in data) || data.spotifyUrl == null || (data.spotifyUrl is string && data.spotifyUrl.size() <= 1000))
        && data.contentChordPro is string && data.contentChordPro.size() <= 100000
        && (!('content' in data) || data.content == null || (data.content is string && data.content.size() <= 100000))
        && (!('folderId' in data) || data.folderId == null || (data.folderId is string && data.folderId.size() <= 128))
        && (!('capo' in data) || data.capo == null || data.capo is number)
        && (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 50))
        && (!('language' in data) || data.language == null || (data.language is string && data.language.size() <= 40))
        && (!('linkedSongIds' in data) || data.linkedSongIds == null || (data.linkedSongIds is list && data.linkedSongIds.size() <= 50))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 5000));
    }

    function isValidSetlist(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'name', 'songIds'])
        && data.keys().hasOnly(['id', 'groupId', 'name', 'date', 'songIds', 'songOverrides', 'notes', 'targetDuration', 'createdAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.groupId == groupId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('date' in data) || (data.date is string && data.date.size() <= 64))
        && data.songIds is list && data.songIds.size() <= 200
        && (!('songOverrides' in data) || data.songOverrides is map)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('targetDuration' in data) || data.targetDuration is number);
    }

    function isValidSetlistHistory(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'setlistName', 'eventType', 'date'])
        && data.keys().hasOnly([
          'id', 'groupId', 'setlistId', 'setlistName', 'eventType', 'date',
          'playedAt', 'durationMinutes', 'location', 'notes', 'songIds',
          'songsSnapshot', 'playedByUid', 'playedByName', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.groupId == groupId
        && data.setlistName is string && data.setlistName.size() >= 1 && data.setlistName.size() <= 200
        && data.eventType in ['rehearsal', 'concert', 'service', 'other']
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 64
        && (!('songIds' in data) || (data.songIds is list && data.songIds.size() <= 200))
        && (!('songsSnapshot' in data) || (data.songsSnapshot is list && data.songsSnapshot.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000));
    }

    function isValidCustomPad(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'name', 'rootSemitone', 'rootKey'])
        && data.keys().hasOnly([
          'id', 'groupId', 'name', 'rootSemitone', 'rootKey', 'audioUrl',
          'audioData', 'fileSize', 'duration', 'createdBy', 'createdByName', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.groupId == groupId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.rootSemitone is number
        && data.rootKey is string && data.rootKey.size() >= 1 && data.rootKey.size() <= 16
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 750000));
    }

    function isValidPlanningTeam(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'name', 'members'])
        && data.keys().hasOnly([
          'id', 'groupId', 'name', 'description', 'color', 'members',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.groupId == groupId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500))
        && (!('color' in data) || data.color == null || (data.color is string && data.color.size() <= 32))
        && data.members is list && data.members.size() <= 100
        && (data.members.size() == 0 || data.members[0] is map)
        && (!('createdBy' in data) || data.createdBy == null || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidMemberGroup(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'name', 'memberIds'])
        && data.keys().hasOnly([
          'id', 'groupId', 'name', 'description', 'color', 'memberIds',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.groupId == groupId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 300))
        && (!('color' in data) || data.color == null || data.color in ['blue', 'emerald', 'purple', 'amber', 'rose', 'slate'])
        && data.memberIds is list && data.memberIds.size() <= 200
        && (data.memberIds.size() == 0 || (data.memberIds[0] is string && data.memberIds[0].size() >= 1 && data.memberIds[0].size() <= 128))
        && (!('createdBy' in data) || data.createdBy == null || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidPlanningAvailability(data, groupId, availId) {
      return data.keys().hasAll(['id', 'groupId', 'date', 'uid', 'displayName', 'status'])
        && data.keys().hasOnly([
          'id', 'groupId', 'date', 'uid', 'displayName', 'status',
          'preferredPoles', 'note', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == availId
        && data.groupId == groupId
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.id == data.date + '_' + data.uid
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.status in ['available', 'maybe', 'unavailable']
        && (!('preferredPoles' in data) || data.preferredPoles == null || (
          data.preferredPoles is list && data.preferredPoles.size() <= 5 && data.preferredPoles.hasOnly(['musique', 'chant', 'regie'])
        ))
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 300));
    }

    function isValidPlanningAssignment(data, groupId) {
      return data.keys().hasAll(['id', 'groupId', 'date', 'title', 'slots'])
        && data.keys().hasOnly([
          'id', 'groupId', 'setlistId', 'setlistName', 'date', 'title',
          'callTime', 'serviceTime', 'location',
          'rehearsalDate', 'rehearsalTime', 'rehearsalLocation',
          'teamPresetId', 'teamPresetName',
          'slots', 'notes', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.groupId == groupId
        && (!('setlistId' in data) || data.setlistId == null || (data.setlistId is string && data.setlistId.size() <= 128))
        && (!('setlistName' in data) || data.setlistName == null || (data.setlistName is string && data.setlistName.size() <= 200))
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('callTime' in data) || data.callTime == null || (data.callTime is string && data.callTime.size() <= 20))
        && (!('serviceTime' in data) || data.serviceTime == null || (data.serviceTime is string && data.serviceTime.size() <= 20))
        && (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 200))
        && (!('rehearsalDate' in data) || data.rehearsalDate == null || (data.rehearsalDate is string && data.rehearsalDate.size() == 10 && data.rehearsalDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && (!('rehearsalTime' in data) || data.rehearsalTime == null || (data.rehearsalTime is string && data.rehearsalTime.size() <= 20))
        && (!('rehearsalLocation' in data) || data.rehearsalLocation == null || (data.rehearsalLocation is string && data.rehearsalLocation.size() <= 200))
        && (!('teamPresetId' in data) || data.teamPresetId == null || (data.teamPresetId is string && data.teamPresetId.size() <= 128))
        && (!('teamPresetName' in data) || data.teamPresetName == null || (data.teamPresetName is string && data.teamPresetName.size() <= 120))
        && data.slots is list && data.slots.size() <= 100
        && (data.slots.size() == 0 || data.slots[0] is map)
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 5000))
        && (!('updatedBy' in data) || data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && (!('updatedByName' in data) || data.updatedByName == null || (data.updatedByName is string && data.updatedByName.size() <= 120));
    }

    function isValidRoadmapImages(images) {
      return images is list
        && images.size() <= 3
        && (
          images.size() == 0 ||
          (
            images[0] is string && images[0].size() >= 1 && images[0].size() <= 260000
            && (images.size() < 2 || (images[1] is string && images[1].size() >= 1 && images[1].size() <= 260000))
            && (images.size() < 3 || (images[2] is string && images[2].size() >= 1 && images[2].size() <= 260000))
          )
        );
    }

    function isValidRoadmapItem(data) {
      return data.keys().hasAll([
          'id', 'title', 'description', 'category', 'status', 'images',
          'authorId', 'authorName', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'description', 'category', 'status', 'images',
          'authorId', 'authorName', 'authorPhotoURL',
          'likesCount', 'commentsCount', 'lastCommentId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && data.category in ['idea', 'bug']
        && data.status in ['idea_bug', 'in_progress', 'live']
        && isValidRoadmapImages(data.images)
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('authorPhotoURL' in data) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048))
        && data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000
        && data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 1000000
        && (!('lastCommentId' in data) || data.lastCommentId == null || (data.lastCommentId is string && data.lastCommentId.size() >= 1 && data.lastCommentId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoadmapLike(data, userId) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt'])
        && data.userId == userId
        && data.createdAt == request.time;
    }

    function isValidRoadmapComment(data, itemId, commentId) {
      return data.keys().hasAll(['id', 'itemId', 'text', 'authorId', 'authorName', 'createdAt'])
        && data.keys().hasOnly(['id', 'itemId', 'text', 'authorId', 'authorName', 'authorPhotoURL', 'createdAt'])
        && data.id == commentId
        && data.itemId == itemId
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && (!('authorPhotoURL' in data) || data.authorPhotoURL == null || (data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048))
        && data.createdAt == request.time;
    }

    // Global App Configuration (branding & default member skills, writes strictly restricted to Supreme Admin)
    match /app_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create: if isValidId(configId)
        && isBootstrappedAdmin()
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          (configId == 'branding' && isValidAppBrandingConfig(incoming())) ||
          (configId == 'member_skills' && isValidMemberSkillsConfig(incoming()))
        );
      allow update: if isValidId(configId)
        && isBootstrappedAdmin()
        && incoming().id == existing().id
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          (configId == 'branding' && isValidAppBrandingConfig(incoming())) ||
          (configId == 'member_skills' && isValidMemberSkillsConfig(incoming()))
        );
      allow delete: if isValidId(configId)
        && configId in ['branding', 'member_skills']
        && isBootstrappedAdmin();
    }

    // Users collection (PII isolated strictly to owner or bootstrapped admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isValidId(userId)
        && (isOwner(userId) || isBootstrappedAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
    }

    // Direct lookup table for joining a library or read-only visitor access by single inviteCode (get only, no list)
    match /library_invites/{inviteCode} {
      allow get: if isValidId(inviteCode) && (
        isSignedIn() ||
        (
          resource != null &&
          exists(groupPath(existing().groupId)) &&
          groupData(existing().groupId).guestEnabled == true
        )
      );
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(inviteCode)
        && isValidLibraryInvite(incoming())
        && (incoming().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow update: if isSignedIn()
        && isValidId(inviteCode)
        && (existing().ownerId == request.auth.uid || isBootstrappedAdmin())
        && isValidLibraryInvite(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().groupId == existing().groupId;
      allow delete: if isSignedIn() && isValidId(inviteCode) && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
    }

    // Libraries (groups) & per-library isolated subcollection databases
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && (isSignedIn() || (resource != null && existing().guestEnabled == true));
      allow list: if isSignedIn() && (
        isBootstrappedAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members
      );
      allow create: if isSignedIn()
        && isValidId(groupId)
        && isValidGroup(incoming())
        && incoming().id == groupId
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().members;
      allow update: if isSignedIn()
        && isValidId(groupId)
        && isValidGroup(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && (
          // Action 0: Supreme Admin manages any library settings, visitor mode, members, roles & accesses
          (
            isBootstrappedAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'inviteCode', 'guestEnabled', 'members', 'memberRoles', 'memberAccesses', 'updatedAt'])
          ) ||
          // Action 1: Library owner manages all library settings including visitor mode, roles & accesses
          (
            existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'inviteCode', 'guestEnabled', 'members', 'memberRoles', 'memberAccesses', 'updatedAt'])
          ) ||
          // Action 2: Library admin (non-owner) manages library metadata, members, roles or accesses (cannot change visitor mode)
          (
            (
              (existing().memberAccesses is map && request.auth.uid in existing().memberAccesses && existing().memberAccesses[request.auth.uid] is list && 'admin' in existing().memberAccesses[request.auth.uid]) ||
              (existing().memberRoles is map && existing().memberRoles.get(request.auth.uid, 'member') == 'admin')
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'inviteCode', 'members', 'memberRoles', 'memberAccesses', 'updatedAt'])
          ) ||
          // Action 3: Authenticated user joins this library by adding only themselves to members
          (
            !(request.auth.uid in existing().members)
            && request.auth.uid in incoming().members
            && incoming().members.hasAll(existing().members)
            && incoming().members.size() == existing().members.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['members'])
          )
        );
      allow delete: if isSignedIn() && isValidId(groupId) && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());

      // Per-library members subcollection
      match /members/{memberId} {
        allow read: if isLibraryMember(groupId);
        allow create: if isLibraryMember(groupId)
          && isValidId(memberId)
          && isValidLibraryMember(incoming())
          && incoming().uid == memberId
          && (
            isLibraryAdmin(groupId) ||
            (memberId == request.auth.uid && incoming().role == 'member' && (!('accesses' in incoming()) || incoming().accesses == ['pupitre'])) ||
            (groupData(groupId).ownerId == request.auth.uid && memberId == request.auth.uid && incoming().role == 'admin') ||
            (canEditLibrarySetlists(groupId) && (memberId in groupData(groupId).members || groupData(groupId).ownerId == memberId) && incoming().role == 'member' && !('accesses' in incoming()))
          );
        allow update: if isLibraryMember(groupId)
          && isValidId(memberId)
          && isValidLibraryMember(incoming())
          && incoming().uid == existing().uid
          && (
            isLibraryAdmin(groupId) ||
            (memberId == request.auth.uid && incoming().role == existing().role && incoming().get('accesses', []) == existing().get('accesses', [])) ||
            (canEditLibrarySetlists(groupId) && incoming().diff(existing()).affectedKeys().hasOnly(['instruments', 'vocalRoles', 'updatedAt']))
          );
        allow delete: if isLibraryMember(groupId)
          && isValidId(memberId)
          && (isLibraryAdmin(groupId) || memberId == request.auth.uid);
      }

      // Per-library songs database (read-only visitor access allowed only if owner enabled guestEnabled)
      match /songs/{songId} {
        allow read: if isLibraryMember(groupId) || isGuestReadableLibrary(groupId);
        allow create: if canEditLibrarySongs(groupId)
          && isValidId(songId)
          && isValidSong(incoming(), groupId);
        allow update: if canEditLibrarySongs(groupId)
          && isValidId(songId)
          && isValidSong(incoming(), groupId)
          && (!('groupId' in existing()) || incoming().groupId == existing().groupId);
        allow delete: if canEditLibrarySongs(groupId) && isValidId(songId);
      }

      // Per-library setlists database (read-only visitor access allowed only if owner enabled guestEnabled)
      match /setlists/{setlistId} {
        allow read: if isLibraryMember(groupId) || isGuestReadableLibrary(groupId);
        allow create: if canEditLibrarySetlists(groupId)
          && isValidId(setlistId)
          && isValidSetlist(incoming(), groupId);
        allow update: if canEditLibrarySetlists(groupId)
          && isValidId(setlistId)
          && isValidSetlist(incoming(), groupId)
          && incoming().groupId == existing().groupId;
        allow delete: if canEditLibrarySetlists(groupId) && isValidId(setlistId);
      }

      // Per-library setlist history database (members only)
      match /setlist_history/{historyId} {
        allow read: if isLibraryMember(groupId);
        allow create: if isLibraryMember(groupId)
          && isValidId(historyId)
          && isValidSetlistHistory(incoming(), groupId);
        allow update: if canEditLibrarySetlists(groupId)
          && isValidId(historyId)
          && isValidSetlistHistory(incoming(), groupId)
          && incoming().groupId == existing().groupId;
        allow delete: if canEditLibrarySetlists(groupId) && isValidId(historyId);
      }

      // Per-library custom pads database
      match /custom_pads/{padId} {
        allow read: if isLibraryMember(groupId) || isGuestReadableLibrary(groupId);
        allow create: if isLibraryMember(groupId)
          && isValidId(padId)
          && isValidCustomPad(incoming(), groupId);
        allow update: if isLibraryMember(groupId)
          && isValidId(padId)
          && isValidCustomPad(incoming(), groupId)
          && incoming().groupId == existing().groupId;
        allow delete: if isLibraryMember(groupId)
          && isValidId(padId)
          && (canEditLibrarySongs(groupId) || existing().createdBy == request.auth.uid);
      }

      // Per-library planning teams (presets created by Responsables / Admins)
      match /planning_teams/{teamId} {
        allow get: if isValidId(teamId) && isLibraryMember(groupId);
        allow list: if isLibraryMember(groupId);
        allow create: if canEditLibrarySetlists(groupId)
          && isValidId(teamId)
          && isValidPlanningTeam(incoming(), groupId)
          && incoming().id == teamId;
        allow update: if canEditLibrarySetlists(groupId)
          && isValidId(teamId)
          && isValidPlanningTeam(incoming(), groupId)
          && incoming().id == existing().id
          && incoming().groupId == existing().groupId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'color', 'members', 'updatedAt'
          ]);
        allow delete: if canEditLibrarySetlists(groupId) && isValidId(teamId);
      }

      // Per-library member date availabilities (each member sets their own; Responsables can also adjust)
      match /planning_availabilities/{availId} {
        allow get: if isValidId(availId) && isLibraryMember(groupId);
        allow list: if isLibraryMember(groupId);
        allow create: if isLibraryMember(groupId)
          && isValidId(availId)
          && isValidPlanningAvailability(incoming(), groupId, availId)
          && (incoming().uid == request.auth.uid || canEditLibrarySetlists(groupId));
        allow update: if isLibraryMember(groupId)
          && isValidId(availId)
          && isValidPlanningAvailability(incoming(), groupId, availId)
          && incoming().id == existing().id
          && incoming().groupId == existing().groupId
          && incoming().date == existing().date
          && incoming().uid == existing().uid
          && (existing().uid == request.auth.uid || canEditLibrarySetlists(groupId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'displayName', 'preferredPoles', 'note', 'updatedAt'
          ]);
        allow delete: if isLibraryMember(groupId)
          && isValidId(availId)
          && (existing().uid == request.auth.uid || canEditLibrarySetlists(groupId));
      }

      // Per-library setlist & date planning rosters (managed by Responsables / Admins)
      match /planning_assignments/{assignmentId} {
        allow get: if isValidId(assignmentId) && isLibraryMember(groupId);
        allow list: if isLibraryMember(groupId);
        allow create: if canEditLibrarySetlists(groupId)
          && isValidId(assignmentId)
          && isValidPlanningAssignment(incoming(), groupId)
          && incoming().id == assignmentId;
        allow update: if canEditLibrarySetlists(groupId)
          && isValidId(assignmentId)
          && isValidPlanningAssignment(incoming(), groupId)
          && incoming().id == existing().id
          && incoming().groupId == existing().groupId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'setlistId', 'setlistName', 'date', 'title', 'callTime', 'serviceTime',
            'location', 'rehearsalDate', 'rehearsalTime', 'rehearsalLocation',
            'teamPresetId', 'teamPresetName', 'slots', 'notes',
            'updatedBy', 'updatedByName', 'updatedAt'
          ]);
        allow delete: if canEditLibrarySetlists(groupId) && isValidId(assignmentId);
      }

      // Per-library organizational member groups (managed by Responsables / Admins)
      match /member_groups/{memberGroupId} {
        allow get: if isValidId(memberGroupId) && isLibraryMember(groupId);
        allow list: if isLibraryMember(groupId);
        allow create: if (isLibraryAdmin(groupId) || canEditLibrarySetlists(groupId))
          && isValidId(memberGroupId)
          && isValidMemberGroup(incoming(), groupId)
          && incoming().id == memberGroupId
          && (!('createdBy' in incoming()) || incoming().createdBy == null || incoming().createdBy == request.auth.uid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if (isLibraryAdmin(groupId) || canEditLibrarySetlists(groupId))
          && isValidId(memberGroupId)
          && isValidMemberGroup(incoming(), groupId)
          && incoming().id == existing().id
          && incoming().groupId == existing().groupId
          && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
          && (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy)
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'color', 'memberIds', 'updatedAt'
          ]);
        allow delete: if (isLibraryAdmin(groupId) || canEditLibrarySetlists(groupId)) && isValidId(memberGroupId);
      }
    }

    // CollectionGroup query for current user's own likes
    match /{path=**}/likes/{userId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Global Roadmap (public read-only for guests & users, authenticated writes)
    match /roadmap_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(itemId)
        && isValidRoadmapItem(incoming())
        && incoming().id == itemId
        && incoming().authorId == request.auth.uid
        && incoming().status == 'idea_bug'
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(itemId)
        && isValidRoadmapItem(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Main app admin changes status (or moderates)
          (
            isBootstrappedAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'title', 'description', 'category', 'images', 'updatedAt'])
          ) ||
          // Action 2: Author edits post content (cannot change status)
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'images', 'updatedAt'])
          ) ||
          // Action 3: Signed-in user adds like atomically
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && incoming().likesCount == existing().likesCount + 1
            && !exists(/databases/$(database)/documents/roadmap_items/$(itemId)/likes/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/roadmap_items/$(itemId)/likes/$(request.auth.uid))
          ) ||
          // Action 4: Signed-in user removes like atomically
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
            && existing().likesCount > 0
            && incoming().likesCount == existing().likesCount - 1
            && exists(/databases/$(database)/documents/roadmap_items/$(itemId)/likes/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/roadmap_items/$(itemId)/likes/$(request.auth.uid))
          ) ||
          // Action 5: Signed-in user adds comment atomically
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'lastCommentId', 'updatedAt'])
            && incoming().commentsCount == existing().commentsCount + 1
            && incoming().lastCommentId is string
            && isValidId(incoming().lastCommentId)
            && !exists(/databases/$(database)/documents/roadmap_items/$(itemId)/comments/$(incoming().lastCommentId))
            && existsAfter(/databases/$(database)/documents/roadmap_items/$(itemId)/comments/$(incoming().lastCommentId))
          ) ||
          // Action 6: Comment author or admin removes comment atomically
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'lastCommentId', 'updatedAt'])
            && existing().commentsCount > 0
            && incoming().commentsCount == existing().commentsCount - 1
            && incoming().lastCommentId is string
            && isValidId(incoming().lastCommentId)
            && exists(/databases/$(database)/documents/roadmap_items/$(itemId)/comments/$(incoming().lastCommentId))
            && !existsAfter(/databases/$(database)/documents/roadmap_items/$(itemId)/comments/$(incoming().lastCommentId))
          )
        );
      allow delete: if isSignedIn()
        && isValidId(itemId)
        && (existing().authorId == request.auth.uid || isBootstrappedAdmin());

      match /likes/{userId} {
        allow get: if isValidId(itemId) && isValidId(userId) && isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && isValidId(itemId)
          && isValidId(userId)
          && request.auth.uid == userId
          && isValidRoadmapLike(incoming(), userId)
          && exists(/databases/$(database)/documents/roadmap_items/$(itemId))
          && getAfter(/databases/$(database)/documents/roadmap_items/$(itemId)).data.likesCount == get(/databases/$(database)/documents/roadmap_items/$(itemId)).data.likesCount + 1;
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(itemId)
          && isValidId(userId)
          && request.auth.uid == userId
          && (
            !exists(/databases/$(database)/documents/roadmap_items/$(itemId)) ||
            getAfter(/databases/$(database)/documents/roadmap_items/$(itemId)).data.likesCount == get(/databases/$(database)/documents/roadmap_items/$(itemId)).data.likesCount - 1
          );
      }

      match /comments/{commentId} {
        allow get: if isValidId(itemId) && isValidId(commentId);
        allow list: if isValidId(itemId);
        allow create: if isSignedIn()
          && isValidId(itemId)
          && isValidId(commentId)
          && isValidRoadmapComment(incoming(), itemId, commentId)
          && incoming().authorId == request.auth.uid
          && exists(/databases/$(database)/documents/roadmap_items/$(itemId))
          && getAfter(/databases/$(database)/documents/roadmap_items/$(itemId)).data.commentsCount == get(/databases/$(database)/documents/roadmap_items/$(itemId)).data.commentsCount + 1;
        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(itemId)
          && isValidId(commentId)
          && (existing().authorId == request.auth.uid || isBootstrappedAdmin())
          && (
            !exists(/databases/$(database)/documents/roadmap_items/$(itemId)) ||
            getAfter(/databases/$(database)/documents/roadmap_items/$(itemId)).data.commentsCount == get(/databases/$(database)/documents/roadmap_items/$(itemId)).data.commentsCount - 1
          );
      }
    }
  }
}
