rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Groups collection
    match /groups/{groupId} {
      allow read, write: if true;
    }

    // Songs collection
    match /songs/{songId} {
      allow read, write: if true;
    }

    // Folders collection
    match /folders/{folderId} {
      allow read, write: if true;
    }

    // Setlists collection
    match /setlists/{setlistId} {
      allow read, write: if true;
    }

    // Setlist history collection
    match /setlist_history/{historyId} {
      allow read, write: if true;
    }
  }
}

